{
  "name": "jewel-labs-desk",
  "productName": "Jewel Labs",
  "version": "1.0.1",
  "description": "Jewel Labs desktop app: AI agents read a diamond shipment's papers, trace every stone's history, check origin and build the customs pack ready to sign.",
  "author": "Jewel Labs <hello@jewellabs.io>",
  "homepage": "https://aarushkandukoori.github.io/jewel-labs-desk/",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "samples": "node samples/generate.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "site:build": "node scripts/build-site.js",
    "eval": "node scripts/eval.js",
    "eval:offline": "node scripts/eval.js --offline",
    "e2e": "node test/e2e/flow.spec.mjs",
    "e2e:packaged": "node test/e2e/packaged.spec.mjs",
    "demo:run": "node scripts/record-run.js",
    "demo:video": "node scripts/record-demo.js",
    "check:backend": "node backend/supabase/tests/check-sql.mjs && node backend/supabase/tests/check-functions.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "imapflow": "^2.12.1",
    "jszip": "^3.10.2",
    "mailparser": "^3.14.4",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "geist": "^1.9.2",
    "htm": "^3.1.1",
    "playwright": "^1.65.1"
  }
}
