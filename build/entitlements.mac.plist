<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the hardened runtime lets the Mac app do. The same three entries as electron-builder's own Electron template,
  written out so the ad hoc build and a Developer ID build sign with exactly the same list.
  allow-jit and allow-unsigned-executable-memory: V8 and WebAssembly (OCR, pdf.js) compile code at run time.
  disable-library-validation: an ad hoc signed app needs it to load the Electron framework. Apple's notary allows all
  three. Never add the debugger entitlement (task allow): the notary rejects it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
